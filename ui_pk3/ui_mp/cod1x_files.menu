		itemDef { name footer_line rect 12 288 496 1 style WINDOW_STYLE_FILLED backcolor BAT_LINE visible 1 decoration }

		itemDef
		{
			name		save_label
			type		ITEM_TYPE_TEXT
			text		"SAVE AS"
			rect		16 296 60 24
			textalign	ITEM_ALIGN_LEFT
			textalignx	0
			textaligny	16
			textscale	.19
			textstyle	ITEM_TEXTSTYLE_SHADOWED
			textfont	UI_FONT_NORMAL
			forecolor	BAT_DIM
			visible		1
			decoration
		}

		itemDef
		{
			name		save_name
			type		ITEM_TYPE_EDITFIELD
			cvar		"cod1x_savename"
			maxChars	24
			maxpaintchars	16
			rect		78 297 116 20
			textalign	ITEM_ALIGN_LEFT
			textalignx	4
			textaligny	14
			textscale	.20
			textfont	UI_FONT_NORMAL
			style		WINDOW_STYLE_FILLED
			backcolor	BAT_ROW
			bordercolor	BAT_BORDER
			border		1
			forecolor	BAT_TEXT
			visible		1
			mouseEnter	{ play "mouse_over"; }
		}

		itemDef
		{
			name		savebtn
			type		ITEM_TYPE_BUTTON
			text		"SAVE"
			style		1
			border		1
			textstyle	3
			rect		200 296 56 22
			textalign	ITEM_ALIGN_CENTER
			textalignx	28
			textaligny	16
			textscale	.21
			textfont	UI_FONT_NORMAL
			forecolor	BAT_TEXT
			backcolor	BAT_BTN
			bordercolor	BAT_BORDER
			visible		1
			mouseEnter	{ play "mouse_over"; setitemcolor savebtn backcolor BAT_BTN_HOV }
			mouseExit	{ setitemcolor savebtn backcolor BAT_BTN }
			action		{ play "mouse_click"; setcvar cod1x_files_save "1" }
		}

		itemDef
		{
			name		refreshbtn
			type		ITEM_TYPE_BUTTON
			text		"REFRESH"
			style		1
			border		1
			textstyle	3
			rect		356 296 70 22
			textalign	ITEM_ALIGN_CENTER
			textalignx	35
			textaligny	16
			textscale	.21
			textfont	UI_FONT_NORMAL
			forecolor	BAT_TEXT
			backcolor	BAT_BTN
			bordercolor	BAT_BORDER
			visible		1
			mouseEnter	{ play "mouse_over"; setitemcolor refreshbtn backcolor BAT_BTN_HOV }
			mouseExit	{ setitemcolor refreshbtn backcolor BAT_BTN }
			action		{ play "mouse_click"; setcvar cod1x_files_scan "1" }
		}

		itemDef
		{
			name		closebtn
			type		ITEM_TYPE_BUTTON
			text		"CLOSE"
			style		1
			border		1
			textstyle	3
			rect		434 296 70 22
			textalign	ITEM_ALIGN_CENTER
			textalignx	35
			textaligny	16
			textscale	.21
			textfont	UI_FONT_NORMAL
			forecolor	BAT_TEXT
			backcolor	BAT_BTN
			bordercolor	BAT_BORDER
			visible		1
			mouseEnter	{ play "mouse_over"; setitemcolor closebtn backcolor BAT_BTN_HOV }
			mouseExit	{ setitemcolor closebtn backcolor BAT_BTN }
			action		{ play "mouse_click"; close cod1x_files }
		}
