#include "ui/menudef.h"
// COD1.6X FILES page - config loader + demo loader (flat dark style, tab of cod1x_settings).
// The menu engine cannot list files; the mod (mss32.dll) scans Main/*.cfg, Main/configs/*.cfg
// and Main/demos/*.dm_* and publishes fixed slots:
//   cod1x_cfg_1..10  display name   cod1x_cfg_exec_1..10  "exec <path>"
//   cod1x_demo_1..10 display name   cod1x_demo_exec_1..10 "demo <file>"  (newest first)
// A slot click runs `vstr` on its exec cvar. Empty slots are hidden (cvarTest/hideCvar).
// SAVE AS: cod1x_savename + cod1x_files_save=1 -> mod runs writeconfig configs/<name>.cfg.
// REFRESH / page open: cod1x_files_scan=1 -> mod rescans.
// Generated by gen_files_menu.py - edit that script, not this file.

#define BAT_BG			.05 .06 .08 .96
#define BAT_BORDER		.16 .18 .22 .8
#define BAT_ROW			.10 .12 .15 .90
#define BAT_ROW_HOV		.16 .19 .24 .95
#define BAT_ORANGE		.98 .55 .10 1
#define BAT_TEXT		.93 .94 .96 1
#define BAT_DIM			.52 .55 .60 1
#define BAT_LINE		.22 .24 .29 .55
#define BAT_BTN			.12 .14 .18 .92
#define BAT_BTN_HOV		.98 .55 .10 .92


{
	menuDef
	{
		name		cod1x_files
		fullScreen	0
		rect		60 76 520 328
		focusColor	.98 .60 .15 1
		style		WINDOW_STYLE_EMPTY
		onOpen		{ setcvar cod1x_menu_open "1" ; setcvar cod1x_files_scan "1" }
		onClose		{ setcvar cod1x_menu_open "0" }
		onESC		{ close cod1x_files }

		itemDef { name panel_shadow rect 6 7 520 328 style WINDOW_STYLE_FILLED backcolor 0 0 0 .5 visible 1 decoration }
		itemDef { name panel_body rect 0 0 520 328 style WINDOW_STYLE_FILLED backcolor BAT_BG border 1 bordercolor BAT_BORDER visible 1 decoration }
		itemDef { name panel_edge rect 0 0 3 328 style WINDOW_STYLE_FILLED backcolor BAT_ORANGE visible 1 decoration }

		itemDef { name title_tick rect 16 13 3 18 style WINDOW_STYLE_FILLED backcolor BAT_ORANGE visible 1 decoration }

		itemDef
		{
			name		title
			type		ITEM_TYPE_TEXT
			text		"COD 1.6X"
			rect		26 8 200 30
			textalign	ITEM_ALIGN_LEFT
			textalignx	0
			textaligny	24
			textscale	.40
			textstyle	ITEM_TEXTSTYLE_SHADOWED
			textfont	UI_FONT_NORMAL
			forecolor	BAT_TEXT
			visible		1
			decoration
		}
		itemDef
		{
			name		tab_files
			type		ITEM_TYPE_TEXT
			text		"FILES"
			rect		434 12 70 22
			textalign	ITEM_ALIGN_CENTER
			textalignx	35
			textaligny	16
			textscale	.21
			textstyle	ITEM_TEXTSTYLE_SHADOWED
			textfont	UI_FONT_NORMAL
			forecolor	BAT_ORANGE
			visible		1
			decoration
		}
		itemDef { name tab_files_bar rect 434 34 70 2 style WINDOW_STYLE_FILLED backcolor BAT_ORANGE visible 1 decoration }

		itemDef { name header_line rect 12 44 496 1 style WINDOW_STYLE_FILLED backcolor BAT_LINE visible 1 decoration }

		itemDef
		{
			name		section_configs
			type		ITEM_TYPE_TEXT
			text		"CONFIGS"
			rect		16 50 200 14
			textalign	ITEM_ALIGN_LEFT
			textalignx	0
			textaligny	11
			textscale	.20
			textstyle	ITEM_TEXTSTYLE_SHADOWED
			textfont	UI_FONT_NORMAL
			forecolor	BAT_ORANGE
			visible		1
			decoration
		}
		itemDef { name section_configs_line rect 92 56 164 1 style WINDOW_STYLE_FILLED backcolor BAT_LINE visible 1 decoration }

		itemDef
		{
			name		section_demos
			type		ITEM_TYPE_TEXT
			text		"DEMOS"
			rect		276 50 200 14
			textalign	ITEM_ALIGN_LEFT
			textalignx	0
			textaligny	11
			textscale	.20
			textstyle	ITEM_TEXTSTYLE_SHADOWED
			textfont	UI_FONT_NORMAL
			forecolor	BAT_ORANGE
			visible		1
			decoration
		}
		itemDef { name section_demos_line rect 340 56 164 1 style WINDOW_STYLE_FILLED backcolor BAT_LINE visible 1 decoration }

		itemDef { name col_split rect 266 64 1 216 style WINDOW_STYLE_FILLED backcolor BAT_LINE visible 1 decoration }

		itemDef { name c1 type ITEM_TYPE_BUTTON rect 16 70 240 18 style WINDOW_STYLE_FILLED backcolor BAT_ROW visible 1 cvarTest "cod1x_cfg_1" hideCvar { "" } mouseEnter { play "mouse_over"; setitemcolor c1 backcolor BAT_ROW_HOV } mouseExit { setitemcolor c1 backcolor BAT_ROW } action { play "mouse_click"; exec "vstr cod1x_cfg_exec_1" } }
		itemDef { name c1t type ITEM_TYPE_TEXT cvar "cod1x_cfg_1" rect 22 70 230 18 textalign ITEM_ALIGN_LEFT textalignx 0 textaligny 13 textscale .19 textfont UI_FONT_NORMAL forecolor BAT_TEXT visible 1 decoration cvarTest "cod1x_cfg_1" hideCvar { "" } }
