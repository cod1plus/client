# ============================================================
# cod1reloaded — .gitignore
# On garde : src/, CMakeLists.txt, build_cod1.ps1, cod1reloaded.ini,
# docs/, tools/*.ps1, les assets HUD, les .md.
# On ignore : tout ce qui est généré, lourd, ou hérité de CoD2x.
# ============================================================

# --- Sortie de compilation (généré) ---
/build/
/dist/
*.o
*.obj
*.a
*.exe
/mss32.dll
/cod1reloaded.dll

# --- Archives / dumps / logs ---
*.zip
*.log
result*.txt

# --- Référence CoD2x (énorme, hors cod1reloaded) ---
/cod2x/

# --- Binaires du jeu pour le RE (gros, non essentiels) ---
/cod1dll/
/images/
/bin/

# --- Toolchain MinGW bundlé (hérité CoD2x) ---
/tools/mingw/
/tools/cmake/
/tools/*.exe

# --- Assets pk3 générés au runtime ---
*.pk3
*.pk3.hash

# --- IDE / OS ---
.vscode/
.idea/
*.user
Thumbs.db
desktop.ini
.DS_Store

# --- Dev / non distribué ---
# On ignore le CONTENU de tools/ (toolchains mingw/cmake, binaires) mais on garde les
# scripts, comme annoncé en tête de fichier. Il faut `/tools/*` et non `/tools/` :
# une négation ne peut pas ré-inclure un fichier si le répertoire lui-même est exclu.
/tools/*
!/tools/*.py
!/tools/*.ps1
!/tools/*.md
/scoreboard-clean*.png
/TODO.md

# --- Binaires serveur Linux copies ici pour analyse (pas des sources) ---
/cod_lnxded
/cod_lnxded.*
/game.mp.i386.so
/linux/
# --- Outils tiers / experimentations hors perimetre ---
/blender-mcp-main/
/build_err.txt
# --- Sources d'assets menu NON expedies (skin texture + police, rejetes 2026-07-17).
#     Seuls ui_pk3/ui_mp/*.menu + les generateurs sont versionnes. 19 Mo evites. ---
/ui_pk3/fonts/
/ui_pk3/ui/
